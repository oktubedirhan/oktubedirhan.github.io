---
import '../styles/global.css';
import { SITE_TITLE, SITE_DESCRIPTION, LINKS } from '../consts';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = SITE_DESCRIPTION } = Astro.props;
const pageTitle = title ? `${title} · ${SITE_TITLE}` : SITE_TITLE;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const hasHero = Astro.slots.has('hero');
const nav = [
  { href: '/blog/', label: 'Blog' },
  { href: '/projeler/', label: 'Projeler' },
  { href: '/hakkimda/', label: 'Hakkımda' },
  { href: '/cv/', label: 'CV' },
];
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#f5f3ee" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#12141a" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      // Kayıtlı tema seçimini boyamadan önce uygula; yoksa sistem tercihi geçerli.
      try {
        const t = localStorage.getItem('tema');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400..700&family=Instrument+Sans:wght@400..700&family=JetBrains+Mono:wght@400;500&family=Source+Serif+4:ital,opsz,wght@0,8..60,400..600;1,8..60,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class:list={[{ 'grid-bg': hasHero }]}>
      <header class="container-wide site-header">
        <a href="/" class="brand">
          <svg class="brand-mark" viewBox="0 0 64 64" width="32" height="32" aria-hidden="true">
            <rect width="64" height="64" rx="16" class="mark-bg" />
            <text x="27" y="46" font-size="40" font-weight="700" text-anchor="middle" class="mark-b">B</text>
            <circle cx="48" cy="42" r="4.5" class="mark-dot" />
          </svg>
          {SITE_TITLE}
        </a>
        <nav aria-label="Ana menü">
          {
            nav.map((item) => (
              <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            ))
          }
        </nav>
        <button class="theme-btn" type="button" aria-label="Koyu temaya geç">
          <svg class="i-moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" /></svg>
          <svg class="i-sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2.5v2M12 19.5v2M4.6 4.6 6 6M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4 6 18M18 6l1.4-1.4" /></svg>
        </button>
      </header>
      {
        hasHero && (
          <div class="container-wide">
            <slot name="hero" />
          </div>
        )
      }
    </div>
    <main class="container-wide">
      <slot />
    </main>
    <footer class="container-wide site-footer">
      <span>© {new Date().getFullYear()} {SITE_TITLE}</span>
      <nav aria-label="Bağlantılar">
        <a href={LINKS.github}>GitHub</a>
        <a href={LINKS.email}>E-posta</a>
        <a href="/rss.xml">RSS</a>
      </nav>
    </footer>
  </body>
</html>

<script>
  const root = document.documentElement;
  const btn = document.querySelector<HTMLButtonElement>('.theme-btn');
  const media = matchMedia('(prefers-color-scheme: dark)');
  const metas = document.querySelectorAll<HTMLMetaElement>('meta[name="theme-color"]');
  const current = () => root.dataset.theme ?? (media.matches ? 'dark' : 'light');

  const sync = () => {
    const mode = current();
    if (btn) {
      btn.dataset.mode = mode;
      btn.setAttribute('aria-label', mode === 'dark' ? 'Açık temaya geç' : 'Koyu temaya geç');
    }
    const paper = getComputedStyle(root).getPropertyValue('--paper').trim();
    metas.forEach((m) => (m.content = paper));
  };

  btn?.addEventListener('click', () => {
    const next = current() === 'dark' ? 'light' : 'dark';
    const apply = () => {
      root.dataset.theme = next;
      try {
        localStorage.setItem('tema', next);
      } catch {}
      sync();
    };
    const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (document.startViewTransition && !calm) document.startViewTransition(apply);
    else apply();
  });
  media.addEventListener('change', sync);
  sync();
</script>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-5);
    justify-content: space-between;
    align-items: center;
    padding-block: var(--space-5);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--ink);
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 19px;
    letter-spacing: -0.01em;
  }
  /* "B." işareti: koyu zemin, kâğıt renginde B, mavi nokta. Koyu temada zemin ve harf yer değiştirir. */
  .brand-mark {
    display: block;
    flex: none;
  }
  .mark-bg {
    fill: var(--ink);
  }
  .mark-b {
    fill: var(--paper);
    font-family: var(--font-display);
  }
  .mark-dot {
    fill: var(--mark-dot);
  }
  .site-header nav {
    display: flex;
    gap: var(--space-1);
  }
  .site-header nav a {
    font-size: 15px;
    line-height: 22px;
    font-weight: 500;
    color: var(--ink-muted);
    text-decoration: none;
    padding: 6px 12px;
    border-radius: var(--radius-md);
  }
  .site-header nav a:hover {
    color: var(--ink);
  }
  .site-header nav a[aria-current='page'] {
    color: var(--ink);
    background: var(--paper-sunk);
  }
  .site-header nav {
    align-items: center;
    margin-left: auto;
  }
  .theme-btn {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    padding: 0;
    border: 0;
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--ink-muted);
    box-shadow: inset 0 0 0 1px var(--rule);
    cursor: pointer;
    transition:
      color 0.15s,
      box-shadow 0.15s;
  }
  .theme-btn:hover {
    color: var(--ink);
    box-shadow: inset 0 0 0 1px var(--ink-muted);
  }
  .theme-btn svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .theme-btn .i-sun,
  .theme-btn[data-mode='dark'] .i-moon {
    display: none;
  }
  .theme-btn[data-mode='dark'] .i-sun {
    display: block;
  }
  /* Dar ekran: marka ve tema düğmesi üst satırda, menü altta */
  @media (max-width: 560px) {
    .site-header nav {
      order: 3;
      flex-wrap: wrap;
      width: calc(100% + 10px);
      margin-left: -10px;
    }
    .site-header nav a {
      padding-inline: 10px;
    }
    .theme-btn {
      margin-left: auto;
    }
  }
  main {
    min-height: 60vh;
    view-transition-name: icerik;
  }
  .site-header {
    view-transition-name: ust;
  }
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    justify-content: space-between;
    align-items: center;
    margin-top: var(--space-8);
    padding-block: var(--space-5) var(--space-6);
    border-top: 1px solid var(--rule);
    font-size: 14px;
    line-height: 20px;
    color: var(--ink-muted);
  }
  .site-footer nav {
    display: flex;
    gap: var(--space-4);
  }
  .site-footer a {
    color: var(--ink-muted);
    text-decoration: none;
  }
  .site-footer a:hover {
    color: var(--accent);
  }
</style>
