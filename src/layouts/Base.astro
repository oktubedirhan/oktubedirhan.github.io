---
import '../styles/global.css';
import { SITE_TITLE, SITE_DESCRIPTION, LINKS } from '../consts';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = SITE_DESCRIPTION } = Astro.props;
const pageTitle = title ? `${title} · ${SITE_TITLE}` : SITE_TITLE;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const hasHero = Astro.slots.has('hero');
const nav = [
  { href: '/blog/', label: 'Blog' },
  { href: '/projeler/', label: 'Projeler' },
  { href: '/hakkimda/', label: 'Hakkımda' },
  { href: '/cv/', label: 'CV' },
];
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#f6f2ea" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#15130f" media="(prefers-color-scheme: dark)" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400..700&family=Instrument+Sans:wght@400..700&family=JetBrains+Mono:wght@400;500&family=Source+Serif+4:ital,opsz,wght@0,8..60,400..600;1,8..60,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class:list={[{ 'grid-bg': hasHero }]}>
      <header class="container-wide site-header">
        <a href="/" class="brand">
          <span class="brand-mark" aria-hidden="true">B</span>
          {SITE_TITLE}
        </a>
        <nav aria-label="Ana menü">
          {
            nav.map((item) => (
              <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            ))
          }
        </nav>
      </header>
      {
        hasHero && (
          <div class="container-wide">
            <slot name="hero" />
          </div>
        )
      }
    </div>
    <main class="container-wide">
      <slot />
    </main>
    <footer class="container-wide site-footer">
      <span>© {new Date().getFullYear()} {SITE_TITLE}</span>
      <nav aria-label="Bağlantılar">
        <a href={LINKS.github}>GitHub</a>
        <a href={LINKS.email}>E-posta</a>
        <a href="/rss.xml">RSS</a>
      </nav>
    </footer>
  </body>
</html>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-5);
    justify-content: space-between;
    align-items: center;
    padding-block: var(--space-5);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--ink);
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 19px;
    letter-spacing: -0.01em;
  }
  .brand-mark {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-md);
    background: var(--kiremit);
    color: var(--on-kiremit);
    font-size: 20px;
    font-weight: 700;
    line-height: 1;
  }
  .site-header nav {
    display: flex;
    gap: var(--space-1);
  }
  .site-header nav a {
    font-size: 15px;
    line-height: 22px;
    font-weight: 500;
    color: var(--ink-muted);
    text-decoration: none;
    padding: 6px 12px;
    border-radius: var(--radius-md);
  }
  .site-header nav a:hover {
    color: var(--ink);
  }
  .site-header nav a[aria-current='page'] {
    color: var(--ink);
    background: var(--paper-sunk);
  }
  main {
    min-height: 60vh;
  }
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    justify-content: space-between;
    align-items: center;
    margin-top: var(--space-8);
    padding-block: var(--space-5) var(--space-6);
    border-top: 1px solid var(--rule);
    font-size: 14px;
    line-height: 20px;
    color: var(--ink-muted);
  }
  .site-footer nav {
    display: flex;
    gap: var(--space-4);
  }
  .site-footer a {
    color: var(--ink-muted);
    text-decoration: none;
  }
  .site-footer a:hover {
    color: var(--kiremit);
  }
</style>
