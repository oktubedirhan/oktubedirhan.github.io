---
// Katman yığını: her katman bir öncekinin altına biraz içeriden oturur.
// Ana sayfadaki öne çıkan projede ve Köprü sayfasında kullanılıyor.
interface Props {
  katmanlar: { ad: string; is: string }[];
  caption?: string;
}

const { katmanlar, caption } = Astro.props;
---

<figure class="stack">
  <ol>
    {
      katmanlar.map((k) => (
        <li>
          <span class="stack-name">{k.ad}</span>
          <span class="stack-role">{k.is}</span>
        </li>
      ))
    }
  </ol>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .stack {
    margin: 0;
    container-type: inline-size;
  }
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 6px;
  }
  li {
    --i: 0;
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    align-items: baseline;
    gap: var(--space-4);
    margin-left: calc(var(--i) * 20px);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    background: var(--paper-raised);
    box-shadow: inset 0 0 0 1px var(--rule);
  }
  li:nth-child(2) {
    --i: 1;
  }
  li:nth-child(3) {
    --i: 2;
  }
  li:nth-child(n + 4) {
    --i: 3;
  }
  li:first-child {
    background: var(--accent);
    box-shadow: none;
  }
  li:first-child .stack-name,
  li:first-child .stack-role {
    color: var(--on-accent);
  }
  .stack-name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 17px;
    line-height: 22px;
  }
  .stack-role {
    font-size: 14px;
    line-height: 20px;
    color: var(--ink-muted);
  }
  figcaption {
    margin-top: var(--space-3);
    font-size: 14px;
    line-height: 20px;
    color: var(--ink-muted);
  }
  /* Dar yerde (telefon, yan sütun) ad ve görev alt alta */
  @container (max-width: 26rem) {
    li {
      grid-template-columns: minmax(0, 1fr);
      gap: 2px;
      margin-left: calc(var(--i) * 10px);
    }
  }
</style>
