---
// Dune süsleri (ilk ekran): yalnızca <html data-mevsim="dune"> varken görünür.
// Arrakis'in iki ayı (küçüğünde kitaplardaki muad'dib, çöl faresi gölgesi), yusufçuk kanatlı bir ornitopter,
// havada süzülen baharat zerreleri. Fareyle gezenlerde imleç arkasında baharat izi bırakır.

// Zerrelerin yeri ve zamanı her derlemede aynı kalsın: basit sabit tohumlu sayı üreteci
let seed = 18;
const rand = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
const motes = Array.from({ length: 22 }, () => ({
  left: (rand() * 100).toFixed(1),
  top: (15 + rand() * 80).toFixed(1),
  size: (2 + rand() * 3).toFixed(1),
  delay: (rand() * -14).toFixed(1),
  dur: (9 + rand() * 8).toFixed(1),
}));
---

<div class="dune" aria-hidden="true">
  <svg class="aylar" viewBox="0 0 120 80" width="120" height="80">
    <circle class="ay" cx="44" cy="40" r="26" />
    <circle class="krater" cx="36" cy="32" r="5" />
    <circle class="krater" cx="54" cy="48" r="3.5" />
    <circle class="krater" cx="50" cy="28" r="2" />
    <g transform="translate(96 20)">
      <circle class="ay" r="13" />
      <!-- muad'dib: ikinci ayın üstündeki fare gölgesi -->
      <g class="fare">
        <ellipse cx="-1.5" cy="1.5" rx="5" ry="3.2" />
        <circle cx="4" cy="-1" r="2.3" />
        <circle cx="3.3" cy="-3.6" r="1.5" />
        <path d="M-6 2.5c-3 1-4.5-1-3.5-4" />
      </g>
    </g>
  </svg>

  <div class="ornitopter">
    <svg viewBox="0 0 110 44" width="132" height="53">
      <path class="direk" d="M37 11v6M67 11v6" />
      <g class="kanat k1"><ellipse cx="37" cy="10" rx="30" ry="3.6" transform="rotate(-7 37 10)" /></g>
      <g class="kanat k2"><ellipse cx="67" cy="10" rx="30" ry="3.6" transform="rotate(7 67 10)" /></g>
      <path class="govde" d="M14 26c0-5 5-9 12-9h44c5 0 8 2 10 4h17l4-4h3l-2 9H80c-2 3-6 5-11 5H26c-7 0-12-2-12-5Z" />
      <path class="cam" d="M16 26c0-4 4-7 9-7h8v10H22c-4 0-6-1-6-3Z" />
      <path class="ayak" d="M34 31l-4 7M66 31l4 7M26 38h8M66 38h8" />
    </svg>
  </div>

  {
    motes.map((m) => (
      <span
        class="zerre"
        style={`left:${m.left}%;top:${m.top}%;width:${m.size}px;height:${m.size}px;animation-delay:${m.delay}s;animation-duration:${m.dur}s`}
      />
    ))
  }
</div>

<script>
  const root = document.documentElement;
  const fine =
    matchMedia('(hover: hover) and (pointer: fine)').matches &&
    !matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (root.dataset.mevsim === 'dune' && fine) {
    let last = 0;
    addEventListener('pointermove', (e) => {
      // 45 ms'de bir tane: iz seyrek ve hafif kalır
      if (e.timeStamp - last < 45) return;
      last = e.timeStamp;
      const dot = document.createElement('span');
      dot.className = 'baharat-izi';
      dot.style.left = `${e.clientX + (Math.random() - 0.5) * 8}px`;
      dot.style.top = `${e.clientY + (Math.random() - 0.5) * 8}px`;
      dot.addEventListener('animationend', () => dot.remove());
      document.body.append(dot);
    });
  }
</script>

<style>
  .dune {
    display: none;
    position: absolute;
    inset: 0 0 auto;
    height: 100vh;
    overflow: hidden;
    pointer-events: none;
    z-index: 1;
  }
  :global(:root[data-mevsim='dune']) .dune {
    display: block;
  }

  .aylar {
    position: absolute;
    top: 84px;
    right: 28px;
  }
  .ay {
    fill: #f6ecd7;
    stroke: var(--rule);
    stroke-width: 1;
  }
  .krater {
    fill: #e6d6b6;
  }
  .fare {
    fill: #b39a72;
    stroke: #b39a72;
    stroke-width: 0.9;
    stroke-linecap: round;
    opacity: 0.8;
  }
  .fare path {
    fill: none;
  }
  :global(:root[data-theme='dark']) .aylar {
    filter: drop-shadow(0 0 14px rgba(246, 236, 215, 0.25));
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .aylar {
      filter: drop-shadow(0 0 14px rgba(246, 236, 215, 0.25));
    }
  }

  /* Soldan sağa geçer, sonra bekler; kanatlar yusufçuk gibi hızla çırpar */
  .ornitopter {
    position: absolute;
    top: 150px;
    left: 0;
    translate: -120px 0;
    animation: uc 19s linear infinite 2s;
  }
  .ornitopter svg {
    display: block;
    animation: suzul 2.2s ease-in-out infinite alternate;
  }
  .govde {
    fill: var(--ink);
  }
  .cam {
    fill: var(--accent);
    opacity: 0.8;
  }
  .ayak,
  .direk {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.4;
    stroke-linecap: round;
  }
  /* Yusufçuk kanatları: hiç kaybolmadan hızla incelip kalınlaşır */
  .kanat {
    fill: var(--ink-muted);
    fill-opacity: 0.45;
    stroke: var(--ink);
    stroke-width: 0.8;
    transform-box: fill-box;
    transform-origin: center;
    animation: cirp 0.09s linear infinite alternate;
  }
  .k2 {
    animation-delay: 0.045s;
  }
  @keyframes uc {
    0% {
      translate: -120px 0;
    }
    50%,
    100% {
      translate: calc(100vw + 20px) -40px;
    }
  }
  @keyframes suzul {
    to {
      transform: translateY(14px) rotate(2deg);
    }
  }
  @keyframes cirp {
    to {
      transform: scaleY(0.2);
    }
  }

  /* Baharat zerreleri: rüzgârla sağa ve yukarı süzülüp söner */
  .zerre {
    position: absolute;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 6px var(--accent);
    opacity: 0;
    animation: zerre 12s linear infinite;
  }
  @keyframes zerre {
    0% {
      opacity: 0;
      translate: 0 0;
    }
    20%,
    70% {
      opacity: 0.55;
    }
    100% {
      opacity: 0;
      translate: 140px -60px;
    }
  }

  :global(.baharat-izi) {
    position: fixed;
    z-index: 30;
    width: 4px;
    height: 4px;
    margin: -2px 0 0 -2px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 6px var(--accent);
    pointer-events: none;
    animation: iz 0.9s ease-out forwards;
  }
  @keyframes iz {
    to {
      opacity: 0;
      translate: 10px 14px;
      scale: 0.4;
    }
  }

  @media (max-width: 760px) {
    .aylar {
      top: 12px;
      right: auto;
      left: 50%;
      width: 72px;
      height: 48px;
      opacity: 0.8;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ornitopter,
    .zerre {
      display: none;
    }
  }
  @media print {
    .dune {
      display: none !important;
    }
  }
</style>
