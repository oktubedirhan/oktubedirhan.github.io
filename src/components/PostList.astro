---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';

interface Props {
  posts: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props;
---

{
  posts.length === 0 ? (
    <p class="muted">Henüz yazı yok.</p>
  ) : (
    <ul>
      {posts.map((post) => (
        <li>
          <a href={`/blog/${post.id}/`}>
            <FormattedDate date={post.data.date} />
            <span class="title">
              {post.data.title}
              <span class="desc">{post.data.description}</span>
            </span>
            <span class="arrow" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ul>
  )
}

<style>
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--rule);
  }
  li {
    border-bottom: 1px solid var(--rule);
  }
  a {
    display: grid;
    grid-template-columns: 7.5rem 1fr auto;
    align-items: baseline;
    gap: var(--space-4);
    padding: var(--space-3) 0;
    color: var(--ink);
    text-decoration: none;
  }
  .title {
    font-weight: 500;
  }
  .desc {
    display: block;
    margin-top: 2px;
    font-size: 15px;
    line-height: 22px;
    font-weight: 400;
    color: var(--ink-muted);
  }
  .arrow {
    color: var(--accent);
    opacity: 0;
    transform: translateX(-4px);
    transition:
      opacity 0.15s,
      transform 0.15s;
  }
  a:hover .title {
    color: var(--accent);
  }
  a:hover .arrow,
  a:focus-visible .arrow {
    opacity: 1;
    transform: none;
  }
  @media (max-width: 560px) {
    a {
      grid-template-columns: 1fr;
      gap: 2px;
    }
    .arrow {
      display: none;
    }
  }
</style>
