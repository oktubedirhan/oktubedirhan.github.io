---
// Cadılar Bayramı hayaleti: yalnızca <html data-mevsim="cadilar"> varken görünür.
// Fareyle gezen ekranlarda imleci biraz geriden izler; dokunmatikte ve azaltılmış harekette sağ altta durur.
---

<div class="hayalet" aria-hidden="true">
  <svg viewBox="0 0 40 48" width="34" height="41">
    <path
      class="govde"
      d="M20 2C10.6 2 4 9 4 18.5V44l5.3-4 5.4 4 5.3-4 5.3 4 5.4-4L36 44V18.5C36 9 29.4 2 20 2Z"
    />
    <ellipse class="goz" cx="14.5" cy="19" rx="2.6" ry="3.4" />
    <ellipse class="goz" cx="25.5" cy="19" rx="2.6" ry="3.4" />
    <ellipse class="goz" cx="20" cy="28" rx="2.4" ry="2" />
  </svg>
</div>

<script>
  const root = document.documentElement;
  const el = document.querySelector<HTMLElement>('.hayalet');
  const follow =
    matchMedia('(hover: hover) and (pointer: fine)').matches &&
    !matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (el && root.dataset.mevsim === 'cadilar' && follow) {
    el.dataset.izle = '';
    let x = innerWidth / 2;
    let y = innerHeight / 2;
    let tx = x;
    let ty = y;
    let frame = 0;

    const step = () => {
      // Hedefe her karede %8 yaklaş: süzülerek gelir
      x += (tx - x) * 0.08;
      y += (ty - y) * 0.08;
      el.style.transform = `translate(${x}px, ${y}px) rotate(${Math.max(-12, Math.min(12, (tx - x) * 0.1))}deg)`;
      frame = Math.abs(tx - x) + Math.abs(ty - y) > 0.5 ? requestAnimationFrame(step) : 0;
    };

    addEventListener('pointermove', (e) => {
      // İmlecin sağ altında, metni kapatmayacak kadar uzakta
      tx = e.clientX + 22;
      ty = e.clientY + 18;
      if (!el.dataset.gorunur) {
        x = tx;
        y = ty;
        el.dataset.gorunur = '';
      }
      if (!frame) frame = requestAnimationFrame(step);
    });
    document.addEventListener('pointerleave', () => delete el.dataset.gorunur);
  }
</script>

<style>
  .hayalet {
    display: none;
    position: fixed;
    z-index: 30;
    pointer-events: none;
  }
  :global(:root[data-mevsim='cadilar']) .hayalet {
    display: block;
    right: var(--space-4);
    bottom: var(--space-4);
  }
  /* İzleme modunda konumu script verir (transform) */
  :global(:root[data-mevsim='cadilar']) .hayalet[data-izle] {
    top: 0;
    left: 0;
    right: auto;
    bottom: auto;
    opacity: 0;
    transition: opacity 0.4s;
  }
  .hayalet[data-izle][data-gorunur] {
    opacity: 0.92;
  }
  .hayalet svg {
    display: block;
    filter: drop-shadow(0 6px 8px rgba(25, 28, 36, 0.18));
    animation: suzul 2.4s ease-in-out infinite;
  }
  /* İki temada da beyaz hayalet */
  .govde {
    fill: #fffefb;
    stroke: #191c24;
    stroke-width: 1.5;
    stroke-linejoin: round;
  }
  .goz {
    fill: #191c24;
  }
  @keyframes suzul {
    50% {
      translate: 0 -5px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hayalet svg {
      animation: none;
    }
  }
  @media print {
    .hayalet {
      display: none !important;
    }
  }
</style>
