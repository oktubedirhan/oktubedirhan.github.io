---
import type { CollectionEntry } from 'astro:content';

type Project = CollectionEntry<'projeler'>['data'];

interface Props {
  project: Project;
}

const { project } = Astro.props;
const href = project.url ?? project.repo;
---

<article>
  <h3><a href={href}>{project.name}</a></h3>
  <p>{project.description}</p>
  <div class="meta">
    {project.tags.map((t) => <span class="tag tag-deniz">{t}</span>)}
    {project.url && project.repo && <a class="repo" href={project.repo}>Kaynak kod</a>}
  </div>
</article>

<style>
  article {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: var(--space-5);
    border-radius: var(--radius-lg);
    background: var(--paper-raised);
    box-shadow: inset 0 0 0 1px var(--rule);
    transition:
      box-shadow 0.15s,
      transform 0.15s;
  }
  article:hover {
    box-shadow:
      inset 0 0 0 1px var(--rule),
      var(--shadow-lift);
    transform: translateY(-2px);
  }
  h3 {
    margin: 0 0 var(--space-2);
  }
  h3 a {
    color: var(--ink);
    text-decoration: none;
  }
  /* Tüm kart tıklanabilir */
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  h3 a:hover {
    color: var(--kiremit);
  }
  p {
    flex: 1;
    margin: 0 0 var(--space-5);
    font-size: 15px;
    line-height: 24px;
    color: var(--ink-muted);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
  }
  .repo {
    position: relative;
    z-index: 1;
    margin-left: auto;
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
  }
  .repo:hover {
    text-decoration: underline;
  }
</style>
