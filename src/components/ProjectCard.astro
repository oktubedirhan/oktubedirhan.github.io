---
import type { Project } from '../utils';
import { ui, localHref, type Lang } from '../i18n';

interface Props {
  project: Project;
  lang?: Lang;
}

const { project, lang = 'tr' } = Astro.props;
const href = localHref(lang, project.url ?? project.repo);
---

<article>
  <h2><a href={href}>{project.name}</a></h2>
  <p>{project.description}</p>
  <div class="meta">
    {project.tags.map((t) => <span class="tag tag-tech">{t}</span>)}
    {project.url && project.repo && <a class="repo" href={project.repo}>{ui[lang].source}</a>}
  </div>
</article>

<style>
  article {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: var(--space-5);
    border-radius: var(--radius-lg);
    background: var(--paper-raised);
    box-shadow: inset 0 0 0 1px var(--rule);
    transition:
      box-shadow 0.15s,
      transform 0.15s;
  }
  article:hover {
    box-shadow:
      inset 0 0 0 1px var(--rule),
      var(--shadow-lift);
    transform: translateY(-2px);
  }
  h2 {
    margin: 0 0 var(--space-2);
    font-variation-settings: 'opsz' 24;
    font-size: 20px;
    line-height: 26px;
    letter-spacing: 0;
  }
  h2 a {
    color: var(--ink);
    text-decoration: none;
  }
  /* Tüm kart tıklanabilir */
  h2 a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  h2 a:hover {
    color: var(--accent);
  }
  p {
    flex: 1;
    margin: 0 0 var(--space-5);
    font-size: 15px;
    line-height: 24px;
    color: var(--ink-muted);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
  }
  .repo {
    position: relative;
    z-index: 1;
    margin-left: auto;
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
  }
  .repo:hover {
    text-decoration: underline;
  }
</style>
