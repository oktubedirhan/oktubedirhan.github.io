---
// Sınıf içi araç: ODTÜ DBE 501, Ocak İYS II için ara sınavlardan kaç lazım. Arama motorlarına kapalı, menüde yok.
import Base from '../layouts/Base.astro';
---

<Base title="İYS II hesaplayıcı" description="DBE 501: İYS II'ye girmek için ara sınavlardan kaç almalısın?" noindex>
  <header class="page-head">
    <p class="label">DBE 501 · Ocak İYS II</p>
    <h1>İYS II'ye girmek için kaç lazım?</h1>
    <p class="lead">Not ekranının görüntüsünü ekle ya da notlarını yaz; henüz girilmemiş notları da söyleyebilirsin. Ara sınavlardan ortalama kaç alman gerektiğini hemen hesaplayayım.</p>
  </header>

  <div class="mt">
    <section class="card gate" id="kapi" aria-labelledby="h-kapi" hidden>
      <h2 id="h-kapi" class="card-title">Önce adın</h2>
      <form id="kapi-form" class="gate-form">
        <label for="ad" class="field-label">Adın ve soyadın</label>
        <input id="ad" name="ad" autocomplete="name" minlength="2" maxlength="40" required placeholder="ör. Ayşe Yılmaz" />
        <button type="submit" class="btn btn-primary">Başla</button>
      </form>
      <p class="hint">Ortalaman bu adla sınıf sıralamasına eklenir. Sıralamada herkes yalnızca ad, sıra ve ortalamayı görür; tek tek quiz, writing, speaking notların kimseye görünmez. İstediğin zaman sıralamadan çıkabilirsin.</p>
      <p class="gate-err" id="kapi-hata" role="alert" hidden></p>
    </section>

    <div class="hello" id="merhaba" hidden>
      <span>Merhaba, <b id="merhaba-ad"></b></span>
      <button type="button" class="link-btn" id="ad-degistir">Adı değiştir</button>
    </div>

    <section class="card" aria-labelledby="h-giris" data-kapili>
      <h2 id="h-giris" class="card-title">1 · Notların</h2>

      <div class="ai" id="drop">
        <ol class="chat" id="sohbet" aria-live="polite">
          <li class="msg bot">Not ekranının görüntüsünü ekle ya da notlarını yaz. Henüz girilmemiş notları da söyleyebilirsin: <i>"WA02'den 70 alırsam?"</i>, <i>"speaking'den 85 aldım"</i>.</li>
        </ol>
        <form class="composer" id="ai-form">
          <div class="thumb" id="onizleme" hidden>
            <img id="onizleme-img" alt="Eklenen ekran görüntüsü" />
            <button type="button" class="thumb-x" id="onizleme-sil" aria-label="Görüntüyü kaldır">×</button>
          </div>
          <label for="mesaj" class="sr-only">Mesajın</label>
          <textarea id="mesaj" rows="2" maxlength="1000" placeholder="ör. QZ04'ten 75 aldım, WA02 için 70 varsay"></textarea>
          <div class="composer-row">
            <input type="file" id="dosya" accept="image/*" class="sr-only" />
            <label for="dosya" class="btn attach">Görüntü ekle</label>
            <button type="submit" class="btn btn-primary" id="gonder">Gönder</button>
          </div>
        </form>
        <p class="hint">Görüntü ve mesajın notları çıkarmak için Mistral'a gönderilir; ortalamayı ve eşiği sayfa kendisi hesaplar. Bilgisayarda görüntüyü sürükleyebilir ya da <kbd>Ctrl</kbd>/<kbd>⌘</kbd>+<kbd>V</kbd> ile yapıştırabilirsin.</p>
      </div>

      <div class="rows-head">
        <h3 class="sub">Notların</h3>
        <span class="hint">Yanlış olan varsa düzelt. <b>AT</b> (devam) hesaba girmez; <b>tahmin</b> işaretliler sıralamaya girmez.</span>
      </div>
      <p class="empty" id="bos">Henüz not yok. Görüntü ekle, yaz ya da elle ekle.</p>
      <ul class="rows" id="satirlar"></ul>
      <button type="button" class="btn add" id="ekle">+ Satır ekle</button>
      <p class="hint legend"><b>QZ</b> quiz · <b>WA</b> writing · <b>SA</b> speaking · <b>MT</b> ara sınav (aldıysan) · <b>AT</b> devam</p>
    </section>

    <section class="card" aria-labelledby="h-ayar" data-kapili>
      <h2 id="h-ayar" class="card-title">2 · Ayarlar</h2>
      <div class="settings">
        <fieldset class="seg">
          <legend class="field-label">Grup</legend>
          <label><input type="radio" name="grup" value="501" checked /><span>501 · 74,50</span></label>
          <label><input type="radio" name="grup" value="401" /><span>401 · 79,50</span></label>
        </fieldset>
        <fieldset class="seg">
          <legend class="field-label">Güzde kaç ara sınav var?</legend>
          <label><input type="radio" name="mtsayi" value="1" /><span>1</span></label>
          <label><input type="radio" name="mtsayi" value="2" checked /><span>2</span></label>
          <label><input type="radio" name="mtsayi" value="3" /><span>3</span></label>
        </fieldset>
      </div>
      <div class="estimates" id="tahminler" hidden></div>
    </section>

    <section class="card result" id="sonuc" aria-live="polite" aria-labelledby="h-sonuc" data-kapili>
      <h2 id="h-sonuc" class="card-title">3 · Sonuç</h2>
      <div id="sonuc-govde"><p class="empty">Notlarını girince sonuç burada çıkacak.</p></div>
    </section>

    <section class="card" aria-labelledby="h-sira" data-kapili>
      <div class="rank-head">
        <h2 id="h-sira" class="card-title">4 · Sınıf sıralaması</h2>
        <span class="save-state" id="kayit-durum" role="status"></span>
      </div>
      <p class="hint">Ara sınav %50, quiz %25, writing %15, speaking %10 ağırlıklı; henüz notu olmayan bileşen hesaba girmez. Tahmini notlar sayılmaz. Herkes kendi notunu girdiği için resmi değil.</p>
      <p class="rank-me" id="sira-ben" hidden></p>
      <ol class="rank" id="sira-liste"></ol>
      <p class="empty" id="sira-bos" hidden></p>
      <button type="button" class="link-btn leave" id="cik" hidden>Beni sıralamadan çıkar</button>
    </section>

    <section class="rule-box" aria-labelledby="h-kural" data-kapili>
      <h2 id="h-kural" class="sub">Kural</h2>
      <p><b>Özel güz ortalaması</b> = Ara sınavlar %50 + Quizler %25 + Writing %15 + Speaking %10. Yuvarlama geçerli: 501'de <b>74,50</b> ve üstü İYS II'ye girer, 74,49 ve altı DBE502'ye devam eder (401'de eşik 79,50).</p>
      <p class="muted">Hesap şu anki notlarla; yeni quiz, writing ya da speaking notu gelince tekrar gir. Resmi değil, kendi hesabımız; son söz DBE'nin.</p>
    </section>
  </div>
</Base>

<script>
  import { parseGrades, compute, scenarios, fmt, rankAverage, COMPONENTS, type GradeRow, type Group, type ComponentKey } from '../lib/mt';
  import { epeHazir, kaydet, siralama, sil, EpeHata, EPE_URL, type SiraSatiri } from '../lib/epe';

  const KEY = 'mt-hesap';
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

  type State = { rows: GradeRow[]; group: Group; count: number; est: Partial<Record<ComponentKey, number | null>> };
  let state: State = { rows: [], group: '501', count: 2, est: {} };

  try {
    const saved = JSON.parse(localStorage.getItem(KEY) ?? 'null');
    if (saved && Array.isArray(saved.rows)) state = { ...state, ...saved };
  } catch {}

  const save = () => {
    try {
      localStorage.setItem(KEY, JSON.stringify(state));
    } catch {}
  };

  const list = $<HTMLUListElement>('satirlar');
  const empty = $('bos');

  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const kind = (code: string) => code.slice(0, 2).toUpperCase();
  const kindName: Record<string, string> = { QZ: 'quiz', WA: 'writing', SA: 'speaking', MT: 'ara sınav', MD: 'ara sınav', AT: 'devam · sayılmaz' };

  function renderRows() {
    empty.hidden = state.rows.length > 0;
    list.innerHTML = state.rows
      .map(
        (r, i) => `<li class="row${kind(r.code) === 'AT' ? ' ignored' : ''}${r.tahmin ? ' guess' : ''}">
          <label class="sr-only" for="kod-${i}">Kod</label>
          <input id="kod-${i}" class="code" data-i="${i}" data-f="code" value="${esc(r.code)}" autocomplete="off" autocapitalize="characters" spellcheck="false" />
          <label class="sr-only" for="not-${i}">Not</label>
          <input id="not-${i}" class="val" data-i="${i}" data-f="value" type="number" inputmode="decimal" min="0" max="100" step="any" value="${Number.isFinite(r.value) ? r.value : ''}" />
          <span class="kind">${kindName[kind(r.code)] ?? '?'}${r.tahmin ? ' · tahmin' : ''}</span>
          <button type="button" class="del" data-del="${i}" aria-label="${esc(r.code)} satırını sil">×</button>
        </li>`,
      )
      .join('');
  }

  list.addEventListener('input', (e) => {
    const el = e.target as HTMLInputElement;
    const i = Number(el.dataset.i);
    if (!state.rows[i]) return;
    if (el.dataset.f === 'code') {
      state.rows[i].code = el.value.toUpperCase().trim();
      const li = el.closest('li')!;
      li.classList.toggle('ignored', kind(state.rows[i].code) === 'AT');
      li.querySelector('.kind')!.textContent = (kindName[kind(state.rows[i].code)] ?? '?') + (state.rows[i].tahmin ? ' · tahmin' : '');
    } else {
      state.rows[i].value = el.value === '' ? NaN : Number(el.value);
    }
    update();
  });
  list.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-del]');
    if (!b) return;
    state.rows.splice(Number(b.dataset.del), 1);
    renderRows();
    update();
  });
  $('ekle').addEventListener('click', () => {
    state.rows.push({ code: 'QZ', value: NaN });
    renderRows();
    update();
    (list.querySelector('li:last-child .code') as HTMLInputElement | null)?.focus();
  });

  function setRows(rows: GradeRow[]) {
    // Asistana ulaşılamadığında yazılı notlar yerelde ayrıştırılıp listeye eklenir (aynı kod üstüne yazar).
    const map = new Map(state.rows.map((r) => [r.code, r]));
    rows.forEach((r) => map.set(r.code, r));
    state.rows = [...map.values()];
    renderRows();
    update();
  }

  // ---- Ayarlar
  document.querySelectorAll<HTMLInputElement>('input[name="grup"]').forEach((r) => {
    r.checked = r.value === state.group;
    r.addEventListener('change', () => {
      state.group = r.value as Group;
      update();
    });
  });
  document.querySelectorAll<HTMLInputElement>('input[name="mtsayi"]').forEach((r) => {
    r.checked = Number(r.value) === state.count;
    r.addEventListener('change', () => {
      state.count = Number(r.value);
      update();
    });
  });

  const estBox = $('tahminler');
  function renderEstimates(missing: ComponentKey[]) {
    const keys = (['QZ', 'WA', 'SA'] as ComponentKey[]).filter((k) => missing.includes(k) || state.est[k] != null);
    const present = new Set(state.rows.filter((r) => Number.isFinite(r.value)).map((r) => kind(r.code)));
    const need = keys.filter((k) => !present.has(k));
    estBox.hidden = need.length === 0;
    const current = estBox.dataset.keys;
    if (current === need.join(',')) return;
    estBox.dataset.keys = need.join(',');
    estBox.innerHTML =
      `<p class="hint">Bunlardan henüz notun yok. Kaç almayı beklediğini yaz:</p>` +
      need
        .map(
          (k) => `<label class="est"><span>${COMPONENTS[k].label}</span>
            <input type="number" inputmode="decimal" min="0" max="100" step="any" data-est="${k}" value="${state.est[k] ?? ''}" placeholder="tahmini not" /></label>`,
        )
        .join('');
  }
  estBox.addEventListener('input', (e) => {
    const el = e.target as HTMLInputElement;
    const k = el.dataset.est as ComponentKey;
    state.est[k] = el.value === '' ? null : Math.min(100, Math.max(0, Number(el.value)));
    update();
  });

  // ---- Sonuç
  const out = $('sonuc-govde');
  const ceil = (n: number) => Math.max(0, Math.ceil(n - 1e-9));

  function update() {
    save();
    queueSync();
    const rows = state.rows.filter((r) => r.code && Number.isFinite(r.value) && r.value >= 0 && r.value <= 100);
    const est = Object.fromEntries(
      Object.entries(state.est).filter(([k]) => !rows.some((r) => kind(r.code) === k)),
    );
    const res = compute(rows, state.group, state.count, est);
    renderEstimates(res.missing);
    const thr = fmt(res.threshold);

    if (!rows.length) {
      out.innerHTML = `<p class="empty">Notlarını girince sonuç burada çıkacak.</p>`;
      return;
    }
    if (res.missing.length) {
      const names = res.missing.map((k) => COMPONENTS[k].label.toLowerCase()).join(', ');
      out.innerHTML = `<p class="empty">Hesap için eksik: <b>${names}</b>. Yukarıdaki Ayarlar'a tahmini notunu yaz ya da satır ekle.</p>`;
      return;
    }

    const r = res.r!;
    const tahminli = rows.some((x) => x.tahmin);
    let big = '';
    if (res.status === 'settled') {
      big = `<div class="verdict ${res.settledPass ? 'ok' : 'bad'}">
        <p class="v-kicker">Bütün ara sınavlar girilmiş</p>
        <p class="v-num">${fmt(res.settledFall!)}</p>
        <p class="v-text">Güz ortalaman bu. ${res.settledPass ? `${thr} eşiğini geçiyorsun, İYS II'ye giriyorsun.` : `${thr} eşiğinin altında kalıyor.`}</p>
      </div>`;
    } else if (res.status === 'free') {
      big = `<div class="verdict ok">
        <p class="v-kicker">Müjde</p>
        <p class="v-num">0</p>
        <p class="v-text">Kalan ara sınavlardan 0 alsan bile ${thr}'ye ulaşıyorsun.</p>
      </div>`;
    } else if (res.status === 'impossible') {
      big = `<div class="verdict bad">
        <p class="v-kicker">Şu anki notlarla yetmiyor</p>
        <p class="v-num">${fmt(res.averageIf100!)}</p>
        <p class="v-text">Kalan ara sınavlardan 100 alsan bile güz ortalaman bu kadar olur, ${thr}'ye ulaşmıyor. Yeni quiz, writing ve speaking notları durumu değiştirebilir.</p>
      </div>`;
    } else if (res.remainingNeeded != null) {
      const left = res.remainingCount;
      big = `<div class="verdict">
        <p class="v-kicker">Kalan ${left === 1 ? 'ara sınavdan' : `${left} ara sınavda ortalama`} en az</p>
        <p class="v-num">${fmt(res.remainingNeeded)}</p>
        <p class="v-text">almalısın. Yani ${left === 1 ? '' : 'her birinden '}<b>${ceil(res.remainingNeeded)}</b> alırsan garanti. (Bütün ara sınavların ortalaması en az ${fmt(res.m!)} olmalı; şu ana kadar ${fmt(res.midtermAvg!)}.)</p>
      </div>`;
    } else {
      big = `<div class="verdict">
        <p class="v-kicker">Ara sınav ortalaman en az</p>
        <p class="v-num">${fmt(res.m!)}</p>
        <p class="v-text">olmalı. Yani ${state.count === 1 ? 'ara sınavdan' : 'her ara sınavdan'} <b>${ceil(res.m!)}</b> alırsan garanti.</p>
      </div>`;
    }

    const parts = [
      ['Quiz', res.quiz!, COMPONENTS.QZ.weight],
      ['Writing', res.writing!, COMPONENTS.WA.weight],
      ['Speaking', res.speaking!, COMPONENTS.SA.weight],
    ] as const;
    const breakdown = parts
      .map(
        ([name, a, w]) => `<tr><th scope="row">${name} <span class="muted">%${Math.round(w * 100)}</span></th>
          <td>${fmt(a.avg)}${a.estimated ? ' <span class="muted">(tahmin)</span>' : a.count > 1 ? ` <span class="muted">(${a.count} not)</span>` : ''}</td>
          <td>+${fmt(a.contribution)}</td></tr>`,
      )
      .join('');

    const table =
      res.status === 'settled'
        ? ''
        : `<h3 class="sub">Ara sınav ortalaman şöyle olursa</h3>
      <table class="scen"><thead><tr><th scope="col">Ara sınav ort.</th><th scope="col">Güz ort.</th><th scope="col">Sonuç</th></tr></thead><tbody>
      ${scenarios(r, state.group)
        .map((s) => `<tr class="${s.pass ? 'pass' : 'fail'}"><td>${s.midterm}</td><td>${fmt(s.fall)}</td><td>${s.pass ? 'Girer' : 'Giremez'}</td></tr>`)
        .join('')}
      </tbody></table>`;

    out.innerHTML = `${big}${tahminli ? '<p class="hint guess-note">Tahmini notlar dahil hesaplandı; sıralamaya yalnızca gerçek notlar girer.</p>' : ''}
      <h3 class="sub">Şu ana kadarki katkın</h3>
      <table class="parts"><tbody>${breakdown}
        <tr class="sum"><th scope="row">Toplam (ara sınavsız)</th><td></td><td>${fmt(r)} / 50</td></tr>
      </tbody></table>
      ${table}`;
  }

  // ---- Yapay zeka asistanı (Supabase edge function "epe-ai" üzerinden Mistral; anahtar sunucuda)
  const AI_URL = `${EPE_URL}/functions/v1/epe-ai`;
  const sohbet = $<HTMLOListElement>('sohbet');
  const mesaj = $<HTMLTextAreaElement>('mesaj');
  const gonder = $<HTMLButtonElement>('gonder');
  const onizleme = $('onizleme');
  const onizlemeImg = $<HTMLImageElement>('onizleme-img');
  let ekli: string | null = null;

  function balon(text: string, who: 'me' | 'bot' | 'err', img?: string) {
    const li = document.createElement('li');
    li.className = `msg ${who}`;
    if (img) {
      const im = document.createElement('img');
      im.src = img;
      im.alt = 'Gönderilen ekran görüntüsü';
      li.append(im);
    }
    if (text) {
      const sp = document.createElement('span');
      sp.textContent = text;
      li.append(sp);
    }
    sohbet.append(li);
    sohbet.scrollTop = sohbet.scrollHeight;
    return li;
  }

  // Görüntüyü en uzun kenarı 1600 px olacak şekilde küçültüp JPEG yapar (istek küçük kalsın).
  async function kucult(file: Blob): Promise<string> {
    const bmp = await createImageBitmap(file);
    const k = Math.min(1, 1600 / Math.max(bmp.width, bmp.height));
    const c = document.createElement('canvas');
    c.width = Math.round(bmp.width * k);
    c.height = Math.round(bmp.height * k);
    const ctx = c.getContext('2d')!;
    ctx.fillStyle = '#fff';
    ctx.fillRect(0, 0, c.width, c.height);
    ctx.drawImage(bmp, 0, 0, c.width, c.height);
    return c.toDataURL('image/jpeg', 0.85);
  }

  async function gorselEkle(file: Blob) {
    try {
      ekli = await kucult(file);
    } catch {
      balon('Bu görüntü açılamadı, başka bir görüntü dene.', 'err');
      return;
    }
    onizlemeImg.src = ekli;
    onizleme.hidden = false;
    mesaj.focus();
  }
  function ekiKaldir() {
    ekli = null;
    onizleme.hidden = true;
    onizlemeImg.removeAttribute('src');
    $<HTMLInputElement>('dosya').value = '';
  }
  $('onizleme-sil').addEventListener('click', ekiKaldir);

  const aiHata: Record<string, string> = {
    anahtar_yok: 'Asistan henüz ayarlanmadı. Notları aşağıdan elle girebilirsin.',
    sinir: 'Bugünkü asistan kullanım sınırı doldu, yarın tekrar dene. Notları aşağıdan elle girebilirsin.',
    mistral_sinir: 'Asistan şu an yoğun, biraz sonra tekrar dene.',
    buyuk: 'Görüntü çok büyük, kırpıp tekrar dene.',
  };

  let mesgul = false;
  async function sor() {
    const text = mesaj.value.trim();
    if (mesgul || (!text && !ekli)) return;
    mesgul = true;
    gonder.disabled = true;
    const image = ekli;
    balon(text, 'me', image ?? undefined);
    mesaj.value = '';
    ekiKaldir();
    const bekle = balon(image ? 'Görüntüye bakıyorum…' : 'Bakıyorum…', 'bot');
    bekle.classList.add('wait');
    try {
      const res = await fetch(AI_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ image, message: text, rows: state.rows.filter((r) => r.code && Number.isFinite(r.value)) }),
      });
      const j = await res.json().catch(() => ({}));
      if (!res.ok || !Array.isArray(j.rows)) throw new Error(j.hata ?? 'baglanti');
      state.rows = j.rows.map((r: GradeRow) => ({ code: r.code, value: r.value, ...(r.tahmin ? { tahmin: true } : {}) }));
      renderRows();
      update();
      bekle.remove();
      balon(j.yanit || 'Listeyi güncelledim.', 'bot');
    } catch (err) {
      bekle.remove();
      const kod = err instanceof Error ? err.message : 'baglanti';
      // Asistana ulaşılamazsa yazılı notları ("QZ04 75") yerelde ayrıştır.
      const varsayim = /alırsam|alsam|olursa|varsay|tahmin|diyelim/i.test(text);
      const yerel = (text ? parseGrades(text) : []).map((r) => (varsayim ? { ...r, tahmin: true } : r));
      if (yerel.length) {
        setRows(yerel);
        balon(`Asistana ulaşılamadı; yazdığın ${yerel.length} notu listeye ekledim.`, 'err');
      } else {
        balon(aiHata[kod] ?? 'Asistana ulaşılamadı. Notları aşağıdan elle girebilirsin.', 'err');
      }
    } finally {
      mesgul = false;
      gonder.disabled = false;
    }
  }

  $('ai-form').addEventListener('submit', (e) => {
    e.preventDefault();
    sor();
  });
  mesaj.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && !e.shiftKey && !e.isComposing && matchMedia('(pointer: fine)').matches) {
      e.preventDefault();
      sor();
    }
  });
  $<HTMLInputElement>('dosya').addEventListener('change', (e) => {
    const f = (e.target as HTMLInputElement).files?.[0];
    if (f) gorselEkle(f);
  });
  document.addEventListener('paste', (e) => {
    const item = [...(e.clipboardData?.items ?? [])].find((i) => i.type.startsWith('image/'));
    if (item) {
      e.preventDefault();
      const f = item.getAsFile();
      if (f) gorselEkle(f);
    }
  });
  const drop = $('drop');
  drop.addEventListener('dragover', (e) => {
    e.preventDefault();
    drop.classList.add('over');
  });
  drop.addEventListener('dragleave', () => drop.classList.remove('over'));
  drop.addEventListener('drop', (e) => {
    e.preventDefault();
    drop.classList.remove('over');
    const f = [...(e.dataTransfer?.files ?? [])].find((f) => f.type.startsWith('image/'));
    if (f) gorselEkle(f);
  });

  // ---- Kimlik ve sınıf sıralaması
  const ID_KEY = 'mt-kimlik';
  type Kimlik = { ad: string; token: string };
  let kimlik: Kimlik | null = null;
  try {
    const k = JSON.parse(localStorage.getItem(ID_KEY) ?? 'null');
    if (k && typeof k.ad === 'string' && typeof k.token === 'string') kimlik = k;
  } catch {}
  const yeniToken = () => crypto.randomUUID() + crypto.randomUUID();
  const kimlikKaydet = () => {
    try {
      if (kimlik) localStorage.setItem(ID_KEY, JSON.stringify(kimlik));
      else localStorage.removeItem(ID_KEY);
    } catch {}
  };

  const gate = $('kapi');
  const gateErr = $('kapi-hata');
  const adInput = $<HTMLInputElement>('ad');
  const kayitDurum = $('kayit-durum');
  const temizAd = (s: string) => s.trim().replace(/\s+/g, ' ');

  function showGate(on: boolean) {
    gate.hidden = !on;
    $('merhaba').hidden = on;
    document.querySelectorAll<HTMLElement>('[data-kapili]').forEach((el) => (el.hidden = on));
    if (on) {
      adInput.value = kimlik?.ad ?? '';
      adInput.focus();
    } else {
      $('merhaba-ad').textContent = kimlik!.ad;
    }
  }

  const hataMetni: Record<string, string> = {
    isim_alinmis: 'Bu isim başka bir cihazdan kaydedilmiş. Aynı kişiysen o cihazdan devam et; değilsen soyadının tamamını ya da bir harf ekle.',
    kapasite_dolu: 'Sıralama dolu, yeni kayıt alınamıyor.',
    baglanti: 'Sunucuya ulaşılamadı. Notların bu cihazda duruyor, sonra tekrar denerim.',
    sunucu: 'Kaydederken bir sorun çıktı. Notların bu cihazda duruyor.',
  };

  $('kapi-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const ad = temizAd(adInput.value);
    if (ad.length < 2) return;
    gateErr.hidden = true;
    const eski = kimlik;
    // Ad değiştiyse eski kayıt silinir, aynı anahtarla yenisi açılır.
    if (eski && eski.ad.toLocaleLowerCase('tr') !== ad.toLocaleLowerCase('tr') && epeHazir()) {
      try {
        await sil(eski.ad, eski.token);
      } catch {}
    }
    kimlik = { ad, token: eski?.token ?? yeniToken() };
    if (epeHazir()) {
      try {
        await kaydetSimdi(true);
      } catch (err) {
        const kod = err instanceof EpeHata ? err.kod : 'baglanti';
        if (kod === 'isim_alinmis') {
          kimlik = eski;
          gateErr.textContent = hataMetni[kod];
          gateErr.hidden = false;
          return;
        }
      }
    }
    kimlikKaydet();
    showGate(false);
    yenileSiralama();
  });
  $('ad-degistir').addEventListener('click', () => showGate(true));

  let syncTimer: number | undefined;
  let sonGonderilen = '';
  function queueSync() {
    if (!kimlik || !epeHazir()) return;
    clearTimeout(syncTimer);
    syncTimer = window.setTimeout(() => kaydetSimdi().catch(() => {}), 1200);
  }

  // force: isim ekranından gelince ortalama olmasa da ismin müsait olduğunu kontrol etmek için.
  async function kaydetSimdi(force = false) {
    if (!kimlik) return;
    const rows = state.rows.filter((r) => r.code && Number.isFinite(r.value) && r.value >= 0 && r.value <= 100);
    const avg = rankAverage(rows);
    if (avg == null && !force) {
      kayitDurum.textContent = 'Not girince sıralamaya eklenirsin';
      return;
    }
    const notlar = rows.filter((r) => !r.tahmin && /^(QZ|WA|SA|MT|MD)/.test(r.code)).map(({ code, value }) => ({ code, value }));
    const imza = JSON.stringify([kimlik.ad, state.group, notlar, avg]);
    if (imza === sonGonderilen || avg == null) return;
    kayitDurum.textContent = 'Kaydediliyor…';
    try {
      await kaydet(kimlik.ad, kimlik.token, state.group, notlar, avg);
      sonGonderilen = imza;
      kayitDurum.textContent = 'Kaydedildi ✓';
      yenileSiralama();
    } catch (err) {
      const kod = err instanceof EpeHata ? err.kod : 'baglanti';
      kayitDurum.textContent = '';
      if (kod === 'isim_alinmis' && !force) {
        gateErr.textContent = hataMetni[kod];
        gateErr.hidden = false;
        showGate(true);
      } else {
        sirayiGoster(null, hataMetni[kod] ?? hataMetni.sunucu);
      }
      throw err;
    }
  }

  async function yenileSiralama() {
    if (!epeHazir()) {
      sirayiGoster(null, 'Sıralama henüz bağlanmadı.');
      return;
    }
    try {
      sirayiGoster(await siralama(state.group));
    } catch {
      sirayiGoster(null, hataMetni.baglanti);
    }
  }

  function sirayiGoster(liste: SiraSatiri[] | null, mesaj?: string) {
    const ol = $<HTMLOListElement>('sira-liste');
    const bos = $('sira-bos');
    const ben = $('sira-ben');
    const benAd = kimlik?.ad.toLocaleLowerCase('tr');
    if (!liste) {
      if (mesaj) {
        bos.textContent = mesaj;
        bos.hidden = false;
      }
      return;
    }
    bos.hidden = liste.length > 0;
    bos.textContent = 'Henüz kimse yok. İlk sen ol.';
    const benimki = liste.find((s) => s.ad.toLocaleLowerCase('tr') === benAd);
    ben.hidden = !benimki;
    if (benimki) ben.innerHTML = `${liste.length} kişi içinde <b>${benimki.sira}.</b> sıradasın`;
    $('cik').hidden = !benimki;
    ol.innerHTML = liste
      .map(
        (s) => `<li class="${s.ad.toLocaleLowerCase('tr') === benAd ? 'me' : ''}">
          <span class="r-no">${s.sira}</span><span class="r-ad">${esc(s.ad)}</span><span class="r-ort">${fmt(s.ortalama)}</span></li>`,
      )
      .join('');
  }

  $('cik').addEventListener('click', async () => {
    if (!kimlik || !confirm('Adın ve ortalaman sıralamadan silinsin mi? Notların bu cihazda kalır.')) return;
    try {
      await sil(kimlik.ad, kimlik.token);
      sonGonderilen = '';
      kimlik = null;
      kimlikKaydet();
      showGate(true);
    } catch {
      sirayiGoster(null, hataMetni.baglanti);
    }
  });
  document.querySelectorAll<HTMLInputElement>('input[name="grup"]').forEach((r) => r.addEventListener('change', yenileSiralama));

  renderRows();
  showGate(!kimlik);
  update();
  if (kimlik) yenileSiralama();
</script>

