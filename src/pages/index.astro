---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { LINKS } from '../consts';
import { getPosts, getProjects } from '../utils';
import home from '../data/home.json';

const posts = (await getPosts()).slice(0, 5);
const projects = await getProjects();
---

<Base>
  <section class="hero" slot="hero">
    <p class="label eyebrow">{home.eyebrow}</p>
    <h1>Merhaba, ben <em>{home.name}</em>.</h1>
    <p class="lead">{home.lead}</p>
    <div class="links">
      <a class="btn btn-primary" href="/blog/">Yazıları oku →</a>
      <a class="btn" href={LINKS.github}>GitHub</a>
      <a class="btn" href={LINKS.email}>E-posta</a>
    </div>
  </section>

  <div class="section-head">
    <h2><span class="label">§ 01</span>Son yazılar</h2>
    <a href="/blog/">Tümü →</a>
  </div>
  <PostList posts={posts} />

  <div class="section-head">
    <h2><span class="label">§ 02</span>Projeler</h2>
    <div class="head-actions">
      <button class="nav-btn" type="button" data-dir="-1" aria-label="Önceki projeler" disabled>←</button>
      <button class="nav-btn" type="button" data-dir="1" aria-label="Sonraki projeler">→</button>
      <a href="/projeler/">Tümü →</a>
    </div>
  </div>
  <div class="rail" tabindex="0" role="region" aria-label="Projeler, yana kaydırılabilir">
    {projects.map((p) => <ProjectCard project={p} />)}
  </div>
</Base>

<script>
  const rail = document.querySelector<HTMLElement>('.rail');
  const buttons = document.querySelectorAll<HTMLButtonElement>('.nav-btn');

  if (rail) {
    const update = () => {
      const max = rail.scrollWidth - rail.clientWidth;
      buttons.forEach((b) => {
        b.disabled = b.dataset.dir === '-1' ? rail.scrollLeft <= 1 : rail.scrollLeft >= max - 1;
      });
      rail.classList.toggle('at-start', rail.scrollLeft <= 1);
      rail.classList.toggle('at-end', rail.scrollLeft >= max - 1);
    };
    buttons.forEach((b) =>
      b.addEventListener('click', () => {
        // Bir kart genişliği kadar kaydır
        const card = rail.firstElementChild as HTMLElement | null;
        const step = card ? card.offsetWidth + 16 : rail.clientWidth * 0.8;
        rail.scrollBy({ left: Number(b.dataset.dir) * step, behavior: 'smooth' });
      }),
    );
    rail.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  }
</script>

<style>
  .hero {
    padding-block: var(--space-8) var(--space-7);
  }
  .eyebrow {
    margin: 0 0 var(--space-4);
  }
  h1 {
    margin: 0;
    font-variation-settings: 'opsz' 96;
    font-size: 56px;
    line-height: 58px;
    letter-spacing: -0.025em;
    max-width: 14ch;
  }
  h1 em {
    font-style: italic;
    font-weight: 500;
    color: var(--kiremit);
  }
  .lead {
    margin-top: var(--space-5);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-6);
  }
  .head-actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .head-actions a {
    margin-left: var(--space-2);
  }
  .nav-btn {
    width: 34px;
    height: 34px;
    border: 0;
    border-radius: var(--radius-pill);
    background: var(--paper-raised);
    box-shadow: inset 0 0 0 1px var(--rule);
    color: var(--ink);
    font: inherit;
    cursor: pointer;
    transition: background 0.15s, opacity 0.15s;
  }
  .nav-btn:hover:not(:disabled) {
    background: var(--kiremit-soft);
    color: var(--kiremit);
  }
  .nav-btn:disabled {
    opacity: 0.35;
    cursor: default;
  }
  .rail {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(17rem, calc((100% - 2 * var(--space-4)) / 3));
    gap: var(--space-4);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 2px;
    overscroll-behavior-x: contain;
    /* Kartın hover gölgesi ve kalkışı kesilmesin */
    padding: 4px 2px var(--space-4);
    margin: -4px -2px 0;
    scrollbar-width: thin;
    scrollbar-color: var(--rule) transparent;
    -webkit-mask-image: linear-gradient(to right, #000 calc(100% - 48px), transparent);
    mask-image: linear-gradient(to right, #000 calc(100% - 48px), transparent);
  }
  .rail.at-end {
    -webkit-mask-image: none;
    mask-image: none;
  }
  .rail:not(.at-start).at-end {
    -webkit-mask-image: linear-gradient(to right, transparent, #000 48px);
    mask-image: linear-gradient(to right, transparent, #000 48px);
  }
  .rail:not(.at-start):not(.at-end) {
    -webkit-mask-image: linear-gradient(to right, transparent, #000 48px, #000 calc(100% - 48px), transparent);
    mask-image: linear-gradient(to right, transparent, #000 48px, #000 calc(100% - 48px), transparent);
  }
  .rail:focus-visible {
    outline: 2px solid var(--kiremit);
    outline-offset: 4px;
  }
  .rail > :global(*) {
    scroll-snap-align: start;
  }
  @media (max-width: 560px) {
    .rail {
      grid-auto-columns: 82%;
    }
    .nav-btn {
      display: none;
    }
    .hero {
      padding-block: var(--space-7) var(--space-6);
    }
    h1 {
      font-size: 40px;
      line-height: 44px;
    }
  }
</style>
