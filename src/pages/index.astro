---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { LINKS } from '../consts';
import { getPosts, getProjects } from '../utils';
import home from '../data/home.json';

const posts = (await getPosts()).slice(0, 5);
const projects = await getProjects();
---

<Base>
  <section class="hero" slot="hero">
    <p class="label eyebrow">{home.eyebrow}</p>
    <h1>Merhaba, ben <em>{home.name}</em>.</h1>
    <p class="lead">{home.lead}</p>
    <div class="links">
      <a class="btn btn-primary" href="/blog/">Yazıları oku →</a>
      <a class="btn" href={LINKS.github}>GitHub</a>
      <a class="btn" href={LINKS.email}>E-posta</a>
    </div>
  </section>

  <div class="section-head">
    <h2><span class="label">§ 01</span>Son yazılar</h2>
    <a href="/blog/">Tümü →</a>
  </div>
  <PostList posts={posts} />

  <div class="section-head">
    <h2><span class="label">§ 02</span>Projeler</h2>
    <a href="/projeler/">Tümü →</a>
  </div>
  <div class="grid">
    {projects.slice(0, 3).map((p) => <ProjectCard project={p} />)}
  </div>
</Base>

<style>
  .hero {
    padding-block: var(--space-8) var(--space-7);
  }
  .eyebrow {
    margin: 0 0 var(--space-4);
  }
  h1 {
    margin: 0;
    font-variation-settings: 'opsz' 96;
    font-size: 56px;
    line-height: 58px;
    letter-spacing: -0.025em;
    max-width: 14ch;
  }
  h1 em {
    font-style: italic;
    font-weight: 500;
    color: var(--kiremit);
  }
  .lead {
    margin-top: var(--space-5);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-6);
  }
  .grid {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
  }
  @media (max-width: 560px) {
    .hero {
      padding-block: var(--space-7) var(--space-6);
    }
    h1 {
      font-size: 40px;
      line-height: 44px;
    }
  }
</style>
