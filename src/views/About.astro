---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { routes, other, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const id = lang === 'en' ? 'en/hakkimda' : 'hakkimda';
const page = await getEntry('sayfalar', id);
if (!page) throw new Error(`src/content/sayfalar/${id}.md bulunamadı`);
const { Content } = await render(page);
---

<Base title={page.data.title} lang={lang} alternate={routes.about[other(lang)]}>
  <header class="page-head">
    <h1>{page.data.title}</h1>
  </header>
  <div class="prose">
    <Content />
  </div>
</Base>
