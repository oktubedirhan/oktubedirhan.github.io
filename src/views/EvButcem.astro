---
// Ev Bütçem proje sayfası. Mağazaya çıkınca kaldırılacak (geçici): bu dosya, src/pages/ev-butcem.astro,
// src/pages/en/ev-butcem.astro, src/content/sayfalar/(en/)ev-butcem.md, src/content/projeler/ev-butcem.json,
// public/media/ev-butcem/, public/ev-butcem/uygulama/ (deneme sürümü), i18n.ts'deki evButcem anahtarları ve public/admin/config.yml'deki ev_butcem girdileri.
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Stack from '../components/Stack.astro';
import Screens from '../components/Screens.astro';
import { getProjects } from '../utils';
import { ui, routes, other, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const id = lang === 'en' ? 'en/ev-butcem' : 'ev-butcem';
const page = await getEntry('sayfalar', id);
if (!page) throw new Error(`src/content/sayfalar/${id}.md bulunamadı`);
const { Content } = await render(page);
// Şema, Projeler'deki Ev Bütçem kaydının Katmanlar alanından çiziliyor.
const katmanlar = (await getProjects(lang)).find((p) => p.url === routes.evButcem.tr)?.katmanlar ?? [];
// Ekranlar burada: proje kaydına konursa ana sayfada Denge'nin ekran açıklamasıyla görünürdü.
const en = lang === 'en';
const ekranlar = [
  { resim: '/media/ev-butcem/ozet.webp', ad: en ? 'Summary' : 'Özet' },
  { resim: '/media/ev-butcem/koc.webp', ad: en ? 'Coach' : 'Koç' },
  { resim: '/media/ev-butcem/kayitlar.webp', ad: en ? 'Search' : 'Arama' },
  { resim: '/media/ev-butcem/hesaplar.webp', ad: en ? 'Accounts' : 'Hesaplar' },
];
---

<Base title={page.data.title} description={t.evButcemDescription} lang={lang} alternate={routes.evButcem[other(lang)]}>
  <header class="page-head">
    <p class="label">{t.kopruKicker} · <span class="keep-case">PWA</span></p>
    <h1>{page.data.title}</h1>
    <p class="lead">{t.evButcemStatus}</p>
    <div class="links">
      <a class="btn btn-primary" href="/ev-butcem/uygulama/">{t.evButcemOpen}</a>
    </div>
    <p class="note">{t.evButcemNote}</p>
    <Screens project={page.data.title} ekranlar={ekranlar} caption={t.evButcemScreens} />
  </header>
  <div class="body">
    {
      katmanlar.length > 0 && (
        <aside class="how" aria-labelledby="how-title">
          <h2 id="how-title">{t.howItWorks}</h2>
          <Stack katmanlar={katmanlar} caption={t.evButcemStack} />
        </aside>
      )
    }
    <div class="prose">
      <Content />
    </div>
  </div>
  <a class="back-link" href={routes.projects[lang]}>{t.allProjects}</a>
</Base>

<style>
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-5);
  }
  .note {
    max-width: 38rem;
    margin: var(--space-3) 0 0;
    font-size: 14px;
    line-height: 20px;
    color: var(--ink-muted);
  }
  /* .label büyük harfe çevirir; kısaltma özgün yazımıyla kalır */
  .keep-case {
    text-transform: none;
  }
  /* Geniş ekranda şema metnin sağında sabit durur; dar ekranda metnin üstünde */
  .body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 19rem;
    gap: var(--space-7);
    align-items: start;
  }
  .how {
    grid-column: 2;
    grid-row: 1;
    position: sticky;
    top: var(--space-6);
  }
  .how h2 {
    margin: 0 0 var(--space-4);
    font-size: 20px;
    line-height: 26px;
  }
  .prose {
    grid-column: 1;
    grid-row: 1;
  }
  @media (max-width: 900px) {
    .body {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-6);
    }
    .how,
    .prose {
      grid-column: auto;
      grid-row: auto;
    }
    .how {
      position: static;
    }
  }
</style>
